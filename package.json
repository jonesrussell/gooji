    "@vitest/ui": "^1.3.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "@vitest/coverage-v8": "^1.3.0",
    "happy-dom": "^12.10.0"
